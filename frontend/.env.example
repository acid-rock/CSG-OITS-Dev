# ── Frontend environment variables ────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# All variables must start with VITE_ to be exposed to the browser by Vite.

# Base URL for the backend API — must include /api/v1 suffix
# Local development:  http://localhost:3000/api/v1
# Production:         https://your-backend-domain.com/api/v1
VITE_API_URL=http://localhost:3000/api/v1

# Public URL of this frontend app — used by /logbook/display to build the QR
# code link that officers scan. Falls back to window.location.origin if unset,
# which works correctly in most deployments (Vercel sets this automatically).
# Only set this explicitly if the auto-detected origin is wrong.
# VITE_FRONTEND_URL=https://your-frontend-domain.com
