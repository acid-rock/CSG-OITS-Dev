# Base URL for the backend API — must include /api/v1 suffix
# Example for local development: http://localhost:3000/api/v1
# Example for production: https://your-backend-domain.com/api/v1
VITE_API_URL=http://localhost:3000/api/v1

# GitHub repository for the System Changelog (Feature 5)
# The repo must be public — no token required
VITE_GITHUB_OWNER=           # GitHub username or organization name (e.g. your-org)
VITE_GITHUB_REPO=            # Repository name (e.g. CSG-OITS-Dev)
