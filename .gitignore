# ── Dependencies ──────────────────────────────────────────────────────────────
# Covers root, frontend/, and backend/ — gitignore patterns are recursive
node_modules/

# ── Environment variables ─────────────────────────────────────────────────────
# .env files contain secrets (API keys, DB URLs, JWTs) — never commit them
.env
.env.*
.env.local
.env.*.local
# Allow the example template so new developers know what variables are needed
!.env.example

# ── Build outputs ─────────────────────────────────────────────────────────────
dist/
dist-ssr/
build/
coverage/
frontend/coverage/
backend/coverage/
.tmp/
.cache/
*.tsbuildinfo
*.lcov

# ── Test artifacts ────────────────────────────────────────────────────────────
playwright-report/
test-results/
blob-report/

# ── Vite ──────────────────────────────────────────────────────────────────────
# Timestamp files written by Vite's dependency pre-bundling
vite.config.ts.timestamp-*
vite.config.js.timestamp-*

# ── Supabase CLI ──────────────────────────────────────────────────────────────
# Local development temp files generated by `supabase start` / `supabase db push`
supabase/.branches/
supabase/.temp/
.supabase/

# ── Generator scripts (one-off, deleted after use) ────────────────────────────
generate-*.js

# ── Local HTTPS certificates (mkcert) ────────────────────────────────────────
# Generated by: mkcert localhost 127.0.0.1 ::1
# Contains private keys — never commit
*.pem
*-key.pem
localhost+*.pem

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── OS files ──────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
desktop.ini

# ── Editor — VS Code ──────────────────────────────────────────────────────────
# User-specific workspace settings and history — differ per developer
.vscode/*
# Allow shared extension recommendations and debug launch configs
!.vscode/extensions.json
!.vscode/launch.json
# Workspace files are machine-specific paths; don't commit them
*.code-workspace

# ── Editor — JetBrains (WebStorm / IntelliJ) ─────────────────────────────────
.idea/
*.iml

# ── Editor — Vim / Emacs ──────────────────────────────────────────────────────
*.swp
*.swo
*.suo
*.sw?
*~
\#*\#

# ── AI assistant tooling ──────────────────────────────────────────────────────
# Claude Code / FleetView project files — machine-specific, not source code
skills-lock.json
.claude/

# ── Generated documents ───────────────────────────────────────────────────────
# Word documents are generated output — regenerate from source if needed
*.docx
# Design reference directories (archived)
frontend/admin_v2026/
frontend/design_migration/
frontend/organization/
frontend/vscode-handoff/
