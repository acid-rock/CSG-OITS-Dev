# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/

# ── Environment variables ──────────────────────────────────────────────────────
# .env files contain secrets — never commit them
.env
.env.*
# Allow the example template so new developers know what variables are needed
!.env.example

# ── Build outputs ──────────────────────────────────────────────────────────────
dist/
dist-ssr/
build/
coverage/
.tmp/
.cache/
*.tsbuildinfo

# ── Local HTTPS certificates (mkcert) ─────────────────────────────────────────
# Generated by: mkcert localhost 127.0.0.1 ::1
# Contains private keys — never commit
*.pem
*-key.pem

# ── Generated documents ────────────────────────────────────────────────────────
# Word documents are generated output — regenerate from source if needed
*.docx

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── OS files ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editor ────────────────────────────────────────────────────────────────────
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
