# ── Backend environment variables ─────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# In production (Render / Railway / etc.) set these as environment variables
# in your hosting platform's dashboard — do NOT commit a filled .env file.

# ── Supabase ───────────────────────────────────────────────────────────────────
# Found in Supabase dashboard → Project Settings → API

# Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Anon / public key — safe to expose; used for public reads
SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — NEVER expose to the frontend; bypasses Row Level Security
SUPABASE_SERVICE_KEY=your-service-role-key-here

# JWT secret — used to verify Supabase-issued access tokens
# Found in: Supabase dashboard → Project Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret-here

# ── Server ─────────────────────────────────────────────────────────────────────

# URL of the frontend application — used to configure CORS
# Production: https://your-frontend-domain.com (e.g. https://csg-oits.vercel.app)
FRONTEND_URL=http://localhost:5173

# HTTP port the Express server listens on (default: 3000)
PORT=3000

# ── PDF Redaction microservice ─────────────────────────────────────────────────
# Optional — URL of the PDF redaction service used by the documents admin panel.
# Leave as localhost if you run the Python service locally; set to the deployed
# service URL in production. The admin panel shows an error if unreachable but
# the rest of the site continues to work.
PDF_REDACT_URL=http://localhost:8000

# ── Email (SMTP) ───────────────────────────────────────────────────────────────
# Optional — required only for borrow request email notifications.
# If SMTP_HOST / SMTP_USER / SMTP_PASS are all blank, emails are silently
# skipped and everything else works normally.
#
# Gmail example (use a 16-char App Password, NOT your account password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=your.address@gmail.com
#   SMTP_PASS=xxxx-xxxx-xxxx-xxxx
#   SMTP_FROM="CSG-OITS" <your.address@gmail.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Central Student Government – OITS" <noreply@example.com>

# ── Digital Office Logbook ─────────────────────────────────────────────────────
# Required — HMAC-SHA256 secret for the rotating QR code tokens.
# Generate one with:  openssl rand -hex 16
# Without this, /logbook/display shows "Display not available".
LOGBOOK_QR_SECRET=generate-a-random-32-char-string-here

# Optional — QR token validity window in seconds (default: 300 = 5 minutes)
LOGBOOK_TOKEN_WINDOW=300

# Optional — Campus network CIDR. When set, only IPs inside this range can call
# GET /api/v1/logbook/qr-token, preventing the display from loading off-campus.
# Leave commented out to disable IP gating (anyone can load the display page).
# CAMPUS_IP_CIDR=192.168.x.x/24
