# Supabase project URL — found in Supabase dashboard > Project Settings > API
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anonymous (public) key — found in Supabase dashboard > Project Settings > API > anon/public
SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key — found in Supabase dashboard > Project Settings > API > service_role
# WARNING: Never expose this key to the frontend. It bypasses Row Level Security.
SUPABASE_SERVICE_KEY=your-service-role-key-here

# JWT secret used to verify Supabase-issued access tokens locally
# Found in Supabase dashboard > Project Settings > API > JWT Settings > JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret-here

# URL of the external PDF redaction microservice
# This service accepts PDF uploads, redacts specified areas, and returns the redacted PDF
# See frontend/src/admin/components/pdf-selector-components/main.py for the service code
PDF_REDACT_URL=http://localhost:8000

# URL of the frontend application — used to configure CORS
# Example: http://localhost:5173 for Vite dev server
FRONTEND_URL=http://localhost:5173

# HTTP port the Express server listens on (defaults to 3000 if not set)
PORT=3000

# ── Email (SMTP) ───────────────────────────────────────────────────────────────
# Required for borrow request email notifications (submission, approval, rejection).
# Leave blank to disable emails — the system works normally without them.
#
# Gmail example (use an App Password, not your account password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=your.address@gmail.com
#   SMTP_PASS=xxxx-xxxx-xxxx-xxxx   ← 16-char App Password from myaccount.google.com/apppasswords
#   SMTP_FROM="CSG-OITS" <your.address@gmail.com>
#
# Other providers: set SMTP_HOST/PORT/SECURE to match your provider's settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Central Student Government – OITS" <noreply@example.com>

# Supabase Management API — used by /api/v1/dashboard/storage
# SUPABASE_PROJECT_REF: the project ref from your Supabase URL (e.g. abcdefghijklmnop from https://abcdefghijklmnop.supabase.co)
# SUPABASE_MANAGEMENT_TOKEN: generate at https://supabase.com/dashboard/account/tokens
SUPABASE_PROJECT_REF=your_project_ref_here
SUPABASE_MANAGEMENT_TOKEN=your_management_token_here
